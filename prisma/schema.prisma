generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED

  @@map("appointment_status")
}

model Dentist {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255) // lowercase enforced by CHECK in migration
  password_hash String   @db.VarChar(255)
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamptz

  appointments Appointment[]

  @@map("dentists")
}

model Patient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name     String   @db.VarChar(100)
  last_name      String   @db.VarChar(100)
  phone_number   String   @db.VarChar(30)
  email          String?  @db.VarChar(255)
  date_of_birth  DateTime @db.Date
  medical_alerts String   @default("") @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  appointments   Appointment[]
  health_reports HealthReport[]

  // patient search (FR: search by name / phone)
  @@index([last_name, first_name], map: "idx_patients_name")
  @@index([phone_number], map: "idx_patients_phone")
  @@map("patients")
}

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id  String            @db.Uuid
  dentist_id  String            @db.Uuid
  start_time  DateTime          @db.Timestamptz
  end_time    DateTime          @db.Timestamptz
  status      AppointmentStatus @default(SCHEDULED)
  canceled_at DateTime?         @db.Timestamptz
  created_at  DateTime          @default(now()) @db.Timestamptz
  updated_at  DateTime          @updatedAt @db.Timestamptz

  patient        Patient        @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  dentist        Dentist        @relation(fields: [dentist_id], references: [id], onDelete: Restrict)
  health_reports HealthReport[]

  // target of the composite FK from health_reports
  @@unique([id, patient_id], map: "uq_appointments_id_patient")
  @@index([dentist_id, start_time], map: "idx_appointments_week_view")
  @@index([patient_id, start_time], map: "idx_appointments_patient")
  @@map("appointments")
}

model HealthReport {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id     String @db.Uuid
  appointment_id String @db.Uuid

  visit_date          DateTime @db.Date
  treatment_performed String   @db.Text
  clinical_notes      String   @db.Text
  created_at          DateTime @default(now()) @db.Timestamptz

  patient      Patient      @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  // composite FK: a report's patient must equal its appointment's patient
  appointment  Appointment  @relation(fields: [appointment_id, patient_id], references: [id, patient_id], onDelete: Restrict)
  report_notes ReportNote[]

  @@index([patient_id, visit_date, created_at], map: "idx_reports_patient_newest")
  @@map("health_reports")
}

model ReportNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id  String   @db.Uuid
  note_text  String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz

  report HealthReport @relation(fields: [report_id], references: [id], onDelete: Restrict)

  @@index([report_id, created_at], map: "idx_report_notes_report")
  @@map("report_notes")
}
